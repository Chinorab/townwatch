# Copy to .env.local and fill in. Never commit real keys.
# Nebius Token Factory (OpenAI-compatible): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Optional model overrides (defaults are the catalogue ids in src/lib/models.ts)
MODEL_TRIAGE=
MODEL_EXPLAIN=
MODEL_FALLBACK=
# Tavily: https://app.tavily.com
TAVILY_API_KEY=
# Upstash Redis (Vercel Marketplace). Leave empty to use the local file store in .cache/
# (the Vercel Marketplace names KV_REST_API_URL and KV_REST_API_TOKEN also work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Bearer secret for the nightly refresh endpoint
CRON_SECRET=
